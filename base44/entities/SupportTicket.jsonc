{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "sender_name": {
      "type": "string",
      "title": "Sender name"
    },
    "sender_email": {
      "type": "string",
      "format": "email",
      "title": "Sender email"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Resolved"
      ],
      "default": "Open",
      "title": "Status"
    },
    "assigned_to_id": {
      "type": "string",
      "title": "Assigned to (TeamMember ID)"
    },
    "messages": {
      "type": "array",
      "title": "Messages",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "customer",
              "team"
            ]
          },
          "text": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "sender_name",
    "sender_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}