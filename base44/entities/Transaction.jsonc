{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ],
      "title": "Type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID"
    },
    "amount": {
      "type": "number",
      "title": "Amount (ZAR)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Paid",
        "Pending"
      ],
      "title": "Status"
    },
    "invoice": {
      "type": "string",
      "title": "Invoice (file URI)",
      "format": "file"
    }
  },
  "required": [
    "type",
    "date",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}