{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "enquiry_type": {
      "type": "string",
      "enum": [
        "Workflow System",
        "Web Application",
        "Process Digitisation",
        "Ongoing Support",
        "Not sure yet"
      ],
      "title": "What do you need?"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "Closed"
      ],
      "default": "New",
      "title": "Status"
    }
  },
  "required": [
    "full_name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}